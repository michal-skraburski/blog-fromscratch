---
import '../styles/global.css';

interface Props {
  title?: string;
  mod?: string;
}
// Supports weights 100-900
import '@fontsource-variable/inter/wght.css';
// IBM Plex Serif (static) — article display
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/700.css';
import SocialLinks from '../components/SocialLinks.astro';

const { title = 'from scratch -', mod = ''} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
  <body class="flex flex-col min-h-svh">
    <div class="w-full max-w-3xl mx-auto grow sans">
      <div class="header mt-6">
        <a href="/" class="text-4xl w-max max-w-3xl font-bold text-paprika cursor-pointer select-none inline">from scratch <p class="text-blue-400">{mod}</p></a>
      </div>
      <slot/>
    </div>
    <svg
      class="fixed top-1/2 right-0 -translate-y-1/2 w-20 h-40 text-inkblack/70 pointer-events-none select-none"
      viewBox="0 0 100 200"
      fill="none"
      stroke="currentColor"
      stroke-width="0.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M92 2 C 64 34, 96 62, 68 92 C 44 118, 82 138, 58 168 C 44 186, 60 194, 74 200" />
    </svg>
    <div class="flex footer mb-4 pt-4 border-t not-italic sans">
      <div class="mx-auto flex items-center gap-4">
        <a class="hyperlink not-italic" href="back">< Back</a>
        <SocialLinks linkClass="hyperlink not-italic" iconClass="w-5 h-5" />
        <a class="hyperlink not-italic" href="webring" aria-label="Webring">
          <svg class="w-6 h-6" viewBox="4.5 4.5 15 15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <g transform="rotate(18 12 12)">
              <circle cx="12" cy="12" r="5"></circle>
              <circle cx="12" cy="7" r="2.2" fill="currentColor" stroke="none"></circle>
              <circle cx="16.33" cy="14.5" r="2.2" fill="currentColor" stroke="none"></circle>
              <circle cx="7.67" cy="14.5" r="2.2" fill="currentColor" stroke="none"></circle>
            </g>
          </svg>
        </a>
        <a class="hyperlink not-italic" href="next"> Next ></a>
      </div>
    </div>
	</body>
</html>
