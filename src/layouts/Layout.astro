---
import '../styles/global.css';

interface Props {
  title?: string;
  mod?: string;
}
// Supports weights 100-900
import '@fontsource-variable/inter/wght.css';
// IBM Plex Serif (static) — article display
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/700.css';
import SocialLinks from '../components/SocialLinks.astro';

const { title = 'from scratch -', mod = ''} = Astro.props;

// Hide the back button on the home page.
const showBack = Astro.url.pathname !== '/';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Render-blocking on purpose: resolve the theme before first paint so there is no flash. -->
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('theme');
				// The system default is authoritative when the user has never chosen one.
				const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				const theme = saved ?? system;

				document.documentElement.dataset.theme = theme;

				// Persist only when the stored value needs to change (e.g. first visit).
				if (saved !== theme) localStorage.setItem('theme', theme);
			})();
		</script>
	</head>
  <body class="flex flex-col min-h-svh">
    <div
      data-scroll-fade
      class="fixed inset-x-0 bottom-0 h-40 pointer-events-none bg-linear-to-t from-bg to-transparent transition-opacity duration-300"
    ></div>
    <script>
      // Hide the bottom fade once scrolled to the very bottom of the page.
      const fade = document.querySelector('[data-scroll-fade]');
      if (fade) {
        const update = () => {
          const atBottom =
            window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 1;
          fade.style.opacity = atBottom ? '0' : '1';
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }
    </script>
    <div class="w-full max-w-2xl mx-auto grow">
      <div class="header mt-6 sans flex">
        <a href="/" class="text-4xl w-max max-w-3xl font-bold text-accent cursor-pointer select-none inline">from scratch <p class="text-blue-400">{mod}</p></a>
        {showBack && (
          <a
            href="/"
            data-back
            class="hyperlink not-italic inline-flex items-center gap-1 ml-auto mb-2 text-text/70 transition-colors hover:text-accent-2"
          >&larr; Back</a>
        )}
      </div>
      <script>
        // Go back in history when possible; fall back to the home link.
        document.querySelectorAll('a[data-back]').forEach((el) => {
          el.addEventListener('click', (e) => {
            if (window.history.length > 1) {
              e.preventDefault();
              window.history.back();
            }
          });
        });
      </script>
      <slot/>
    </div>
    <svg
      class="fixed top-1/2 right-0 -translate-y-1/2 w-20 h-40 text-text/70 pointer-events-none select-none"
      viewBox="0 0 100 200"
      fill="none"
      stroke="currentColor"
      stroke-width="0.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M92 2 C 64 34, 96 62, 68 92 C 44 118, 82 138, 58 168 C 44 186, 60 194, 74 200" />
    </svg>
      <div class="flex footer mb-4 pt-4 border-t not-italic sans">
      <div class="mx-auto flex items-center gap-4">
        <a class="hyperlink not-italic" href="https://webring.webdev-webdesign.com/prev/?from=https%3A%2F%2Fskraburski.com%2F">&larr; Back</a>
        <SocialLinks linkClass="hyperlink not-italic" iconClass="w-5 h-5" />
        <a class="hyperlink not-italic" href="https://webring.webdev-webdesign.com" aria-label="Webring">
          <svg class="w-6 h-6" viewBox="4.5 4.5 15 15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <g transform="rotate(18 12 12)">
              <circle cx="12" cy="12" r="5"></circle>
              <circle cx="12" cy="7" r="2.2" fill="currentColor" stroke="none"></circle>
              <circle cx="16.33" cy="14.5" r="2.2" fill="currentColor" stroke="none"></circle>
              <circle cx="7.67" cy="14.5" r="2.2" fill="currentColor" stroke="none"></circle>
            </g>
          </svg>
        </a>
        <a class="hyperlink not-italic" href="https://webring.webdev-webdesign.com/next/?from=https%3A%2F%2Fskraburski.com%2F"> Next &rarr;</a>
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle color theme"
          class="hyperlink not-italic group inline-flex items-center gap-1.5 cursor-pointer"
        >
          <svg data-icon-sun class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <svg data-icon-moon class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span data-theme-label>Light</span>
        </button>
      </div>
    </div>
    <script>
      // Theme toggle: flip data-theme on <html>, persist, and keep the label/icon in sync.
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const label = document.querySelector('[data-theme-label]');
      const sync = () => {
        if (label) label.textContent = root.dataset.theme === 'dark' ? 'Dark' : 'Light';
      };
      sync();
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        sync();
      });
    </script>
	</body>
</html>
