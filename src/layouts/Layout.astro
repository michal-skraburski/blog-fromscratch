---
import '../styles/global.css';

interface Props {
	title?: string;
}
// Supports weights 100-900
import '@fontsource-variable/inter/wght.css';
// IBM Plex Serif (static) — article display
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/700.css';

const { title = 'from scratch -' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
  <body class="flex flex-col min-h-svh">
    <div class="max-w-3xl mx-auto grow">
      <div class="header mt-6">
        <a href="/" class="text-4xl w-max max-w-3xl font-bold text-paprika cursor-pointer select-none">from scratch</a>

      </div>
      <slot/>
    </div>
    <div class="flex footer mb-4 pt-4 border-t not-italic">
      <div class="mx-auto flex gap-2">
        <a class="hyperlink not-italic" href="back">< Back</a>
        <a class="hyperlink not-italic" href="https://www.github.com/michal-skraburski">github</a>
        <a class="hyperlink not-italic" href="https://www.linkedin.com/in/michalskraburski">linkedin</a>
        <a class="hyperlink not-italic" href="webring">webring</a>
        <a class="hyperlink not-italic" href="next"> Next ></a>
      </div>
    </div>
	</body>
</html>
