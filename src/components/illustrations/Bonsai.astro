---
// Material 3-styled bonsai: rounded, tonal foliage blobs over a terracotta pot.
// Decorative only — sits in the aside column of the inspirations index.
---

<svg
	viewBox="0 0 200 220"
	class="w-40 mx-auto text-accent"
	fill="none"
	aria-hidden="true"
	role="presentation"
>
	<!-- Foliage: layered tonal green blobs (dark base, mid body, light highlight). -->
	<g>
		<!-- dark base, offset down-right for depth -->
		<g fill="#2E5D3B">
			<circle cx="74" cy="86" r="27" />
			<circle cx="108" cy="60" r="33" />
			<circle cx="138" cy="90" r="24" />
			<circle cx="112" cy="92" r="26" />
		</g>
		<!-- mid body -->
		<g fill="#40916C">
			<circle cx="70" cy="80" r="25" />
			<circle cx="104" cy="54" r="31" />
			<circle cx="134" cy="84" r="22" />
			<circle cx="108" cy="86" r="24" />
		</g>
		<!-- light highlights -->
		<g fill="#95D5B2">
			<circle cx="96" cy="46" r="14" />
			<circle cx="64" cy="72" r="9" />
			<circle cx="128" cy="76" r="8" />
		</g>
	</g>

	<!-- Trunk: warm brown, curving up from the pot into the canopy. -->
	<path
		d="M100 176 C 96 150, 84 138, 92 118 C 98 104, 108 102, 106 92"
		stroke="#6B4A2B"
		stroke-width="11"
		stroke-linecap="round"
	/>
	<path
		d="M96 132 C 108 128, 120 122, 132 118"
		stroke="#6B4A2B"
		stroke-width="7"
		stroke-linecap="round"
	/>

	<!-- Pot: rounded terracotta trapezoid with a soil-line rim, tinted from the accent. -->
	<rect x="58" y="168" width="84" height="12" rx="6" fill="currentColor" opacity="0.85" />
	<path
		d="M64 182 h72 a4 4 0 0 1 3.9 4.9 l-4.4 20 A6 6 0 0 1 129.6 212 H70.4 a6 6 0 0 1-5.9-5.1 l-4.4-20 A4 4 0 0 1 64 182 Z"
		fill="currentColor"
	/>
</svg>
