---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const inspirations = (await getCollection('inspo')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<Layout title="Inspirations" mod="inspirations">
	<section class="mt-8">
		<ul class="mt-6 space-y-6">
			{
				inspirations.map((item) => (
					<li>
						<a
							href={item.data.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group block"
						>
							<h2 class="text-xl font-semibold text-inkblack group-hover:text-choco">
								{item.data.title}
							</h2>
							{item.data.author && item.data.author !== item.data.title && (
								<p class="text-sm text-inkblack/60">{item.data.author}</p>
							)}
							{item.data.description && (
								<p class="mt-1 text-inkblack/80">{item.data.description}</p>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
