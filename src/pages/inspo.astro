---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Bonsai from '../components/illustrations/Bonsai.astro';
import Cover from '../components/Cover.astro';

const inspirations = (await getCollection('inspo')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<Layout title="Inspirations" mod="inspirations">
	<Bonsai slot="illustration" />
	<section class="my-8 mx-5">
		<ul class="mt-6 space-y-6">
			{
				inspirations.map((item) => (
					<li class="group">
						<a
							href={item.data.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group block"
						>
							<h2 class="text-xl font-semibold text-text transition-colors group-hover:text-accent-2">
								{item.data.title}
							</h2>
							{item.data.author && item.data.author !== item.data.title && (
								<p class="text-sm text-text/60">{item.data.author}</p>
							)}
							{item.data.description && (
								<p class="mt-1 text-text/80">{item.data.description}</p>
							)}
							<Cover
								image={item.data.image}
								class="mt-3 w-full aspect-video rounded-lg object-cover border border-text/15 bg-surface"
							/>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
