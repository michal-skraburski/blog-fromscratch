---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Hypercon from '../components/Hypercon.astro';
---

<Layout title="Home">
  <div class="flex flex-col items-center mt-40 italic">
    hyperlinks
    <div class="flex flex-col bg-teal-50 items-center border w-50 mt-1 rounded mx-4 transition-shadow transition-colors shadow-2xl">
      <Hypercon tag='blogs' href='blog' a_class='px-6'/>
      <Hypercon tag='bookmarks & tools' href='tools' />
      <Hypercon tag='projects' href="projects" />
      <Hypercon tag='inspirations' href="inspo" div_class="mb-6"/>
    </div> 
  </div>
  <div class="flex flex-col mt-16 items-center italic">
    connections 
    <div class="flex flex-col bg-teal-50 items-center border rounded shadow-2xl w-20 divide-y">
      <SocialLinks linkClass="hyperlink py-4 px-4 border-text" iconClass="w-6 h-6" />
    </div>
  </div>
</Layout>
