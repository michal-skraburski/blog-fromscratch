---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);
---

<Layout title="Projects" mod="projects">
	<section class="mt-8 mx-5">
		<ul class="mt-6 space-y-6">
			{
				projects.map((project) => (
					<li class="group flex items-start gap-3">
						<span class="mt-2 shrink-0 w-2.5 h-2.5 rounded-full border border-text/40 transition-colors group-hover:border-accent-2 group-hover:bg-accent-2"></span>
						<a href={`/projects/${project.id}`} class="group block">
							<h2 class="text-xl font-semibold text-text transition-colors group-hover:text-accent-2">
								{project.data.title}
							</h2>
							{project.data.description && (
								<p class="mt-1 text-text/80">{project.data.description}</p>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
