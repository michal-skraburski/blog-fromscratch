---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { cover } from '../../lib/image';

const projects = (await getCollection('projects')).sort(
	(a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);
---

<Layout title="Projects" mod="projects">
	<section class="mt-8 mx-5">
		<ul class="mt-6 space-y-6">
			{
				projects.map((project) => (
					<li class="group">
						<a href={`/projects/${project.id}`} class="group block">
							<h2 class="text-xl font-semibold text-text transition-colors group-hover:text-accent-2">
								{project.data.title}
							</h2>
							{project.data.description && (
								<p class="mt-1 text-text/80">{project.data.description}</p>
							)}
							<img
								src={cover(project.data.image)}
								alt=""
								loading="lazy"
								class="mt-3 w-full aspect-video rounded-lg object-cover border border-text/15 bg-surface"
							/>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
