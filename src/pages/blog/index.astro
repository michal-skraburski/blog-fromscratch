---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Map project id -> title, to tag each post with its project.
const projectTitles = new Map(
	(await getCollection('projects')).map((p) => [p.id, p.data.title]),
);
---

<Layout title="Blog" mod="blogs">
	<section class="my-10 mx-5">
		<ul class="mt-6 space-y-6">
			{
				posts.map((post) => (
					<li class="group">
						<a href={`/blog/${post.id}`} class="group block">
							<h2 class="text-xl font-semibold text-text transition-colors group-hover:text-accent-2">
								{post.data.title}
							</h2>
							<div class="text-sm text-text/60">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
								</time>
								{post.data.project && projectTitles.has(post.data.project.id) && (
									<span class="ml-2 rounded-full border border-text/20 px-2 py-0.5 text-xs text-text/70">
										{projectTitles.get(post.data.project.id)}
									</span>
								)}
							</div>
							{post.data.description && (
								<p class="mt-1 text-text/80">{post.data.description}</p>
							)}
							<Cover
								image={post.data.image}
								class="mt-3 w-full aspect-video rounded-lg object-cover border border-text/15 bg-surface"
							/>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
