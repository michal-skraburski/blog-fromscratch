---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog" mod="blogs">
	<section class="mt-8">
		<ul class="mt-6 space-y-6 mx-20">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}`} class="group block">
							<h2 class="text-xl font-semibold text-inkblack group-hover:text-choco">
								{post.data.title}
							</h2>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="text-sm text-inkblack/60"
							>
								{post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
							</time>
							{post.data.description && (
								<p class="mt-1 text-inkblack/80">{post.data.description}</p>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
