---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Map project id -> title, to tag each post with its project.
const projectTitles = new Map(
	(await getCollection('projects')).map((p) => [p.id, p.data.title]),
);
---

<Layout title="Blog" mod="blogs">
	<section class="mt-8 mx-5">
		<ul class="mt-6 space-y-6">
			{
				posts.map((post) => (
					<li class="group flex items-start gap-3 max-w-fit">
						<span class="mt-2 shrink-0 w-2.5 h-2.5 rounded-full border border-inkblack/40 transition-colors group-hover:border-choco group-hover:bg-choco"></span>
						<a href={`/blog/${post.id}`} class="group block">
							<h2 class="text-xl font-semibold text-inkblack transition-colors group-hover:text-choco">
								{post.data.title}
							</h2>
							<div class="text-sm text-inkblack/60">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
								</time>
								{post.data.project && projectTitles.has(post.data.project.id) && (
									<span class="ml-2 rounded-full border border-inkblack/20 px-2 py-0.5 text-xs text-inkblack/70">
										{projectTitles.get(post.data.project.id)}
									</span>
								)}
							</div>
							{post.data.description && (
								<p class="mt-1 text-inkblack/80">{post.data.description}</p>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
