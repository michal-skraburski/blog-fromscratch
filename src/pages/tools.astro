---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';

const tools = (await getCollection('tools')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);
---

<Layout title="Bookmarks & tools" mod="bookmarks & tools">
	<section class="my-8 mx-5">
		<ul class="mt-6 space-y-6">
			{
				tools.map((tool) => (
					<li class="group">
						<a
							href={tool.data.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group block"
						>
							<h2 class="text-xl font-semibold text-text transition-colors group-hover:text-accent-2">
								{tool.data.title}
							</h2>
							{tool.data.description && (
								<p class="mt-1 text-text/80">{tool.data.description}</p>
							)}
							<Cover
								image={tool.data.image}
								class="mt-3 w-full aspect-video rounded-lg object-cover border border-text/15 bg-surface"
							/>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
